# Docker PostgreSQL + pgvector from docker-compose.yml (start it with: docker compose up -d).
# User, password, port and database must match the db service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/double_take
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
# Optional; defaults to claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5
